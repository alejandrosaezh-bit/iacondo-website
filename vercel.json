{
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://app.iacondo.com/demo",
      "permanent": false
    },
    {
      "source": "/demo/(.*)",
      "destination": "https://app.iacondo.com/demo/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/panel",
      "destination": "/index.html"
    },
    {
      "source": "/panel/(.*)",
      "destination": "/index.html"
    }
  ]
}
